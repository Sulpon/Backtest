// Structures
isStructBodyCandleBreak = input(true, title='Break with candle\'s body', group="Structures")
// Continuous extreme tracking (the running structureHigh/structureLow while
// a phase is still developing, no new BOS/CHoCH yet) keeps extending on
// every bar that makes a new extreme. If a bar-count gap this wide passes
// with NO new extreme, the high/low locks for the rest of the phase - a
// later extreme past that gap is no longer accepted. Making a new extreme
// resets the gap counter, so an active, still-developing swing never locks
// early; only a genuine pause of this length does.
structureExtremeLockBars = input.int(5, "Lock High/Low After N Bars With No New Extreme", minval=1, maxval=50, group="Structures")
isCurrentStructToShow = input(true, title='Display current structure', group="Structures")
bullishBosColor = input(color.silver, 'Bullish BOS Color', group="Structures")
bearishBosColor = input(color.silver, 'Bearish BOS Color', group="Structures")
bosLineStyleOption = input.string("─", title="BOS Style", group="Structures", options=["─", "┈", "╌"])
bosLineStyle = getLineStyle(bosLineStyleOption)
bosLineWidth = input.int(1, title="BOS Width", group="Structures", minval=1, maxval=5)
bullishChochColor = input(color.yellow, 'Bullish CHoCH Color', group="Structures")
bearishChochColor = input(color.yellow, 'Bearish CHoCH Color', group="Structures")
chochLineStyleOption = input.string("─", title="CHoCH Style", group="Structures", options=["─", "┈", "╌"])
chochLineStyle = getLineStyle(chochLineStyleOption)
chochLineWidth = input.int(1, title="MSB Width", group="Structures", minval=1, maxval=5)
currentStructColor = input(color.blue, 'Current structure Color', group="Structures")
currentStructLineStyleOption = input.string("─", title="Current structure Style", group="Structures", options=["─", "┈", "╌"])
currentStructLineStyle = getLineStyle(currentStructLineStyleOption)
currentStructLineWidth = input.int(1, title="Current structure Width", group="Structures", minval=1, maxval=5)
// TRADE MODEL REWRITE: structHistoryNbr (max 50) replaced per request. Two
// separate caps now exist because Pine hard-caps ANY single indicator at
// 500 lines / 500 labels / 500 boxes simultaneously (a platform ceiling,
// not a choice) - maxHistoricalStructure governs how many events are
// tracked in the CALCULATION arrays (can go up to 1000, matching the
// request), while maxDisplayedStructureLines governs how many of those are
// actually drawn as line/label objects, kept well under the 500 ceiling
// since FVG boxes, trade Fibonacci, and markers all share that same budget
// across the whole indicator.
showAllHistoricalStructure = input.bool(true, "Show All Historical Structure", group="Structures")
maxHistoricalStructure = input.int(1000, "Maximum Historical Structure Events (calculation)", minval=50, maxval=1000, group="Structures")
maxDisplayedStructureLines = input.int(1000, "Max Structure Lines Actually Drawn (shared drawing-object budget with FVG/trade drawing)", minval=10, maxval=1000, group="Structures")
structHistoryNbr = maxDisplayedStructureLines

