// ============================================================================
// BOS RESEARCH FILTERS (new) - completely optional, all default OFF. Applied
// ONLY to same-direction continuation BOS (the original script's own "BOS"
// case, as opposed to "CHoCH" which is the opposite-direction reversal).
// With every filter below disabled, output is byte-for-byte identical to
// the original script - verified by construction, since every filter gate
// short-circuits to "pass" when its own enable toggle is off (see the
// isStuctureLowBroken/isStructureHighBroken redefinition further down).
//
// NAMING NOTE: the original script already has an ALWAYS-ACTIVE input also
// called "Minimum Swing Size (%)" (minSwingPercent, group "Structures",
// feeding bullishContinuationReady/bearishContinuationReady). Filter 3 below
// is a SEPARATE, independently-toggleable mechanism and would collide with
// that existing variable name if given the name from the request verbatim -
// so it's named contMinSwingPercent here instead. The original
// minSwingPercent input and its behavior are completely untouched.
// ============================================================================
enableMinSameDirectionBars = input.bool(false, "Enable Minimum Same-Direction BOS Bars", group="BOS Filters")
minSameDirectionBars = input.int(10, "Minimum Same-Direction BOS Bars", minval=1, maxval=500, group="BOS Filters")

enableMinRetracement = input.bool(false, "Enable Minimum Retracement Filter", group="BOS Filters")
minRetracementPercent = input.float(25.0, "Minimum Retracement (%)", minval=0, maxval=100, step=1, group="BOS Filters")

enableMinSwingPercent = input.bool(false, "Enable Minimum Swing Size (%)", group="BOS Filters")
contMinSwingPercent = input.float(20.0, "Continuation Min Swing Size (%) [Filter 3 - separate from the Structures group's always-on swing filter above]", minval=0, maxval=500, step=1, group="BOS Filters")

enableMinSwingPips = input.bool(false, "Enable Minimum Swing Size (Pips)", group="BOS Filters")
