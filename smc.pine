pipSize = input.float(0.0001, "Pip Size", minval=0.000001, group="BOS Filters")

enableMinBosDistance = input.bool(false, "Enable Minimum BOS Price Distance", group="BOS Filters")
minBosDistancePips = input.float(20.0, "Minimum BOS Price Distance (Pips)", minval=0, step=0.1, group="BOS Filters")

enableAtrFilter = input.bool(false, "Enable ATR Minimum Swing Filter", group="BOS Filters")
atrLength = input.int(14, "ATR Length", minval=1, maxval=200, group="BOS Filters")
atrMultiplier = input.float(0.5, "Minimum Swing ATR Multiplier", minval=0, step=0.1, group="BOS Filters")

filterCombination = input.string("ALL ENABLED FILTERS", "Filter Combination", options=["ALL ENABLED FILTERS", "ANY ENABLED FILTER"], group="BOS Filters")

showBosFilterDebug = input.bool(false, "Show BOS Filter Debug", group="Debug")
showDebugTables = input.bool(true, "Show Debug Tables", group="Debug")
// ============================================================================
// TRADE MODEL (revised per latest spec) - consumes accepted BOS/CHoCH events
// only, does not feed back into the structure engine. One setup per
// accepted event. Setup states: ACTIVE_SETUP, INVALIDATED, ENTERED,
// CLOSED_WIN, CLOSED_LOSS. An unentered setup is invalidated (never
// deleted) by the next accepted event; an entered trade is fully
// independent of later events and only closes via TP/SL.
// ============================================================================
showTradeFib = input.bool(true, "Show Trade Fibonacci", group="Trade Fibonacci")
fibLineLengthBars = input.int(8, "Fibonacci Line Length (Bars) - horizontal display length only, does NOT change the price range/levels", minval=1, maxval=100, group="Trade Fibonacci")
maxDisplayedTradeFibs = input.int(100, "Max Trade Fibonacci Ranges Actually Drawn (most recent)", minval=1, maxval=300, group="Trade Fibonacci")
bullishFibColor = input.color(color.new(color.lime, 60), "Bullish Trade Fib Color", group="Trade Fibonacci")
bearishFibColor = input.color(color.new(color.red, 60), "Bearish Trade Fib Color", group="Trade Fibonacci")
tpColor = input.color(color.new(color.green, 0), "TP Color", group="Trade Fibonacci")
slColor = input.color(color.new(color.red, 0), "SL Color", group="Trade Fibonacci")

sameBarExitMode = input.string("Conservative", "Same Candle TP/SL", options=["Conservative", "Optimistic", "Ignore"], group="Trade Model")
allowMultipleOpenTrades = input.bool(true, "Allow Multiple Open Trades", group="Trade Model")
maxStoredTradeEvents = input.int(5000, "Maximum Stored Trade Events", minval=100, maxval=10000, group="Trade Model")

// Defaulted off - only the Trade Fibonacci (TP 0 / ENTRY 0.71 / SL 1
