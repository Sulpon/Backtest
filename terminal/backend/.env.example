# Market data provider selection. MarketDataService talks only to the
# MarketDataProvider interface (app/marketdata/provider.py) - this is the
# only setting that should ever need to change to switch broker.
MARKET_DATA_PROVIDER=fxcm

# FXCM (https://fxcm-rest.readthedocs.io) - IMPORTANT: FXCM does not accept
# US residents at all (a 2017 CFTC settlement bans it, not just a policy
# preference) - this includes demo accounts, not only live/funded ones.
#   1. Sign up for a demo account at https://www.fxcm.com (outside the US)
#   2. Log in to Trading Station Web (https://tradingstation.fxcm.com)
#   3. Generate an access token from there (User Account -> Token Management)
FXCM_ACCESS_TOKEN=
# "demo" (api-demo.fxcm.com) or "real" (api.fxcm.com)
FXCM_ENVIRONMENT=demo

# OANDA (https://developer.oanda.com) is also implemented and can be used
# instead by setting MARKET_DATA_PROVIDER=oanda - broader account
# eligibility (no US restriction) and a more precisely documented API, but
# not the provider currently selected above.
#   1. Sign up at https://www.oanda.com (practice account, no funding needed)
#   2. Log in to the fxTrade practice portal -> "Manage API Access" under
#      My Services -> generate a personal access token
#   3. Your account ID (format 101-001-XXXXXXX-001) is shown on the same page
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
