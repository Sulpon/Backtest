{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "installCommand": "pip install -r requirements.txt && python fetch_db.py",
      "functions": {
        "app/main.py": {
          "excludeFiles": "{tests/**,.pytest_cache/**,.venv/**,pytest.ini,requirements-dev.txt,build_db.py,sync_market_data.py,fetch_db.py,.env.example,README.md,.gitignore}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
