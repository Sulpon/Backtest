# Copy to .env.local to override. Both are optional - these are the defaults.

# Where the FastAPI backend is running.
VITE_API_BASE=http://localhost:8000

# "api" (default) reads through FastAPI/DuckDB - the backend must be running.
# "static" reads the pre-generated files under public/data instead, for a
# frontend-only offline demo with no backend required.
VITE_DATA_LAYER=api
