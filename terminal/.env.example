# Copy to .env.local to override. Both are optional - these are the defaults.

# Where the FastAPI backend is running.
#
# Local dev (default, shown above): the backend runs separately on its own
# port, so this must be an absolute cross-origin URL.
#
# Vercel production, deployed as ONE project via vercel.json's "services"
# (see terminal/README.md#deploying-to-vercel): frontend and backend share
# one domain, so set this to an EMPTY string in the Vercel dashboard - the
# app will then call same-origin relative paths like "/api/symbols" instead
# of a cross-origin URL, and no CORS configuration is needed in production.
#
# Vercel production, deployed as TWO SEPARATE projects (fallback if your
# plan doesn't have the Services feature): set this to the backend
# project's full URL, e.g. https://your-backend.vercel.app, and also set
# CORS_ALLOWED_ORIGINS on the backend (see backend/.env.example) to the
# frontend project's URL.
VITE_API_BASE=http://localhost:8000

# "api" (default) reads through FastAPI/DuckDB - the backend must be running.
# "static" reads the pre-generated files under public/data instead, for a
# frontend-only offline demo with no backend required.
VITE_DATA_LAYER=api
